# Copy required variables into the appropriate local environment file. 
# Never commit real credentials

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_APP_NAME=AquaMind
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OpenAI
AQUAMIND_AGENT_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=

# Public deployment controls (leave disabled for local development)
AQUAMIND_PUBLIC_MODE=0
AQUAMIND_INFERENCE_ENABLED=1
AQUAMIND_RELAY_REQUIRED=0
AQUAMIND_RELAY_SECRET=
AQUAMIND_USAGE_STORE=sqlite
AQUAMIND_USAGE_DB=
AQUAMIND_AI_DAILY_STAGE_LIMIT=20
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostgreSQL
DATABASE_URL=

# Redis / rate limiting
REDIS_URL=
REDIS_TOKEN=

# Weather
WEATHER_API_KEY=
