# Copy required variables into the appropriate local environment file. 
# Never commit real credentials

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_APP_NAME=AquaMind
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OpenAI
AQUAMIND_AGENT_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL
DATABASE_URL=

# Redis / rate limiting
REDIS_URL=
REDIS_TOKEN=

# Weather
WEATHER_API_KEY=
