{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "out/dataset",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["scripts/export-dataset.ts"]
}
